# ── Django API ──────────────────────────────────────────────
DJANGO_API_URL=https://yourdomain.com
N8N_WEBHOOK_SECRET=generate-a-random-secret-here

# ── Google Sheets ────────────────────────────────────────────
# Get from the Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_YOUR_ID/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# ── Telegram Bot (free instant notifications) ────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates to get your chat_id
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwXyZ
TELEGRAM_CHAT_ID=your-numeric-chat-id

# ── Phantombuster (optional, for post scraping) ──────────────
PHANTOMBUSTER_API_KEY=your-phantombuster-key
