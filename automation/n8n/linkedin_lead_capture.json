{
  "name": "LinkedIn Lead Capture Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "linkedin-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook: New LinkedIn Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "notes": "Receives lead data from Phantombuster or manual trigger"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.email }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "filter-has-email",
      "name": "Filter: Has Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $now.toISO() }}",
            "Full Name": "={{ $json.fullName }}",
            "LinkedIn URL": "={{ $json.linkedinUrl }}",
            "Job Title": "={{ $json.jobTitle }}",
            "Company": "={{ $json.company }}",
            "City": "={{ $json.city }}",
            "Country": "={{ $json.country }}",
            "Email": "={{ $json.email }}",
            "Phone": "={{ $json.phone }}",
            "Engagement Type": "={{ $json.engagementType }}",
            "Post URL": "={{ $json.postUrl }}",
            "Status": "New",
            "Notes": ""
          }
        }
      },
      "id": "google-sheets-log",
      "name": "Google Sheets: Log Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [700, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DJANGO_API_URL }}/api/leads/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "full_name",
              "value": "={{ $json.fullName }}"
            },
            {
              "name": "email",
              "value": "={{ $json.email }}"
            },
            {
              "name": "phone",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "city",
              "value": "={{ $json.city }}"
            },
            {
              "name": "source",
              "value": "linkedin"
            },
            {
              "name": "engagement_type",
              "value": "={{ $json.engagementType }}"
            },
            {
              "name": "linkedin_url",
              "value": "={{ $json.linkedinUrl }}"
            },
            {
              "name": "notes",
              "value": "={{ $json.jobTitle }} at {{ $json.company }}"
            }
          ]
        }
      },
      "id": "django-api-create-lead",
      "name": "Django API: Create Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [700, 360]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🔔 *New LinkedIn Lead*\n\n👤 *Name:* {{ $json.fullName }}\n💼 *Title:* {{ $json.jobTitle }}\n🏢 *Company:* {{ $json.company }}\n📍 *City:* {{ $json.city }}\n📧 *Email:* {{ $json.email }}\n🔗 *LinkedIn:* {{ $json.linkedinUrl }}\n📌 *Engaged via:* {{ $json.engagementType }}\n\n_Auto-captured via n8n_",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-notify",
      "name": "Telegram: Notify Me",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [700, 520]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.engagementType }}",
              "operation": "equals",
              "value2": "comment"
            }
          ]
        }
      },
      "id": "filter-is-commenter",
      "name": "Filter: Is Commenter?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [960, 300]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=✍️ *Action Required — Send DM*\n\n{{ $json.fullName }} commented on your post.\n\n💬 Draft DM:\n\"Hey {{ $json.firstName }}, thanks for engaging with my post! I'd love to share the full resource with you — mind if I send it over?\"\n\n🔗 Profile: {{ $json.linkedinUrl }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-dm-reminder",
      "name": "Telegram: DM Reminder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\", \"message\": \"Lead captured\" }"
      },
      "id": "webhook-response",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 460]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"skipped\", \"reason\": \"no email\" }"
      },
      "id": "webhook-response-skipped",
      "name": "Webhook Response: Skipped",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [700, 700]
    }
  ],
  "connections": {
    "Webhook: New LinkedIn Lead": {
      "main": [
        [{ "node": "Filter: Has Email?", "type": "main", "index": 0 }]
      ]
    },
    "Filter: Has Email?": {
      "main": [
        [
          { "node": "Google Sheets: Log Lead", "type": "main", "index": 0 },
          { "node": "Django API: Create Lead", "type": "main", "index": 0 },
          { "node": "Telegram: Notify Me", "type": "main", "index": 0 }
        ],
        [{ "node": "Webhook Response: Skipped", "type": "main", "index": 0 }]
      ]
    },
    "Telegram: Notify Me": {
      "main": [
        [{ "node": "Filter: Is Commenter?", "type": "main", "index": 0 }]
      ]
    },
    "Filter: Is Commenter?": {
      "main": [
        [{ "node": "Telegram: DM Reminder", "type": "main", "index": 0 }],
        [{ "node": "Webhook Response", "type": "main", "index": 0 }]
      ]
    },
    "Telegram: DM Reminder": {
      "main": [
        [{ "node": "Webhook Response", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
