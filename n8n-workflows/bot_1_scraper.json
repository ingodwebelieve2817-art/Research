      "id": "a1b2c3d4-0001-0001-0001-000000000010",
      "name": "Merge: + Google News",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1440, 480]
    },
    {
      "parameters": {
        "jsCode": "// Deduplicate by title and filter for funding-related articles only\nconst items = $input.all();\nconst seen = new Set();\nconst fundingKeywords = [\n  'funding', 'raises', 'raised', 'investment', 'seed round',\n  'series a', 'series b', 'series c', 'pre-series', 'venture capital',\n  'startup fund', 'crore', 'million', 'billion', 'vc', 'angel round',\n  'backed by', 'led by', 'capital', 'round'\n];\n\nconst filtered = [];\nfor (const item of items) {\n  const title = (item.json.title || '').toLowerCase();\n  const content = (item.json.content || item.json.contentSnippet || '').toLowerCase();\n  const combined = title + ' ' + content;\n\n  // Skip if already seen\n  if (seen.has(title)) continue;\n  seen.add(title);\n\n  // Only keep funding-related articles\n  const isFundingRelated = fundingKeywords.some(kw => combined.includes(kw));\n  if (!isFundingRelated) continue;\n\n  // Skip if article is older than 24 hours\n  const pubDate = item.json.pubDate || item.json.isoDate;\n  if (pubDate) {\n    const articleAge = Date.now() - new Date(pubDate).getTime();\n    const hoursOld = articleAge / (1000 * 60 * 60);\n    if (hoursOld > 24) continue;\n  }\n\n  filtered.push({\n    json: {\n      title: item.json.title,\n      link: item.json.link,\n      pubDate: item.json.pubDate || item.json.isoDate,\n      snippet: (item.json.contentSnippet || item.json.content || '').substring(0, 500)\n    }\n  });\n}\n\nreturn filtered;"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000011",
      "name": "Deduplicate & Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, 480]
    },
    {
      "parameters": {
        "batchSize": 5,
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000012",
      "name": "Batch Articles (5 at a time)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1920, 480]
    },
    {
      "parameters": {
        "jsCode": "// Bundle batch items into a single formatted string for Claude\nconst items = $input.all();\nconst articlesText = items.map((item, i) => {\n  return `Article ${i + 1}:\\nTitle: ${item.json.title}\\nURL: ${item.json.link}\\nSnippet: ${item.json.snippet}\\nDate: ${item.json.pubDate}`;\n}).join('\\n\\n---\\n\\n');\n\nreturn [{ json: { articlesText, count: items.length } }];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000013",
      "name": "Prepare Claude Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2160, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 2048,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are an expert venture capital data analyst. I will give you news article titles and snippets. Extract ONLY articles about Indian startups that received equity funding (seed, pre-series A, Series A/B/C/D, or growth rounds). Ignore debt funding, acquisitions, and non-India companies.\\n\\nFor each valid startup funding event, return a JSON array. Each element must have these exact keys:\\n- startupName: Company name\\n- website: Official website URL (infer from context or leave empty string)\\n- fundingDetails: Amount raised + round type (e.g. '$5M Seed', 'Rs 50 Cr Series A')\\n- founders: Founder names and titles if mentioned (or 'Not mentioned')\\n- sourceUrl: The article URL\\n- description: One sentence about what the company does\\n\\nReturn ONLY a valid JSON array. No markdown, no explanation, no code blocks. If no valid funding articles exist, return an empty array [].\\n\\nArticles:\\n{{ $json.articlesText }}\"\n    }\n  ]\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000014",
      "name": "Claude: Extract Startup Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2400, 480],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse Claude's response and flatten into individual startup records\nconst item = $input.first();\nconst responseBody = item.json;\n\nlet contentText = '';\ntry {\n  contentText = responseBody.content[0].text;\n} catch (e) {\n  return [];\n}\n\nlet startups = [];\ntry {\n  // Remove any accidental markdown formatting\n  const cleaned = contentText.replace(/```json|```/g, '').trim();\n  startups = JSON.parse(cleaned);\n} catch (e) {\n  console.log('Claude parse error:', e.message, 'Raw:', contentText);\n  return [];\n}\n\nif (!Array.isArray(startups) || startups.length === 0) return [];\n\nreturn startups.map(s => ({\n  json: {\n    'Startup Name': s.startupName || '',\n    'Website': s.website || '',\n    'Funding Details': s.fundingDetails || '',\n    'Founders': s.founders || 'Not mentioned',\n    'Source URL': s.sourceUrl || '',\n    'Description': s.description || '',\n    'Status': 'Pending Outreach',\n    'LinkedIn Draft': '',\n    'Email Draft': ''\n  }\n}));"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000015",
      "name": "Parse Claude Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2640, 480]
    },
